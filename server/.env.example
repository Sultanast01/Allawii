BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=your_sandbox_api_key_here
JWT_SECRET=change-this-to-a-random-secret
PORT=3001

# WhatsApp Business Cloud API — from the Meta app dashboard.
# WHATSAPP_APP_SECRET is the app's "App Secret"; the webhook refuses traffic without it.
WHATSAPP_APP_SECRET=paste_the_app_secret_from_meta_dashboard
WHATSAPP_VERIFY_TOKEN=any_random_string_you_type_into_meta_console
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=the_test_number_id_from_meta
WHATSAPP_GRAPH_VERSION=v23.0
