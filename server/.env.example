# B Moni partner key. This is the shared sandbox key published in B Moni's own
# API reference (https://bkey.mintlify.app/api-reference/introduction) and it
# only works against the development base URL — not a secret, never production.
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4
PORT=3001

# Only needed when a separate front-end host must call this API — a comma-separated
# list of origins. Leave unset when the same process serves the built app (the normal
# deploy), which is same-origin and needs none of this.
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Supabase — Project Settings → API in the Supabase dashboard.
# The service role key bypasses RLS: server-only, never ship it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=paste_the_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=paste_the_service_role_secret_key

# Telegram assistant. A Node host polls Telegram from this process (started by
# `npm run dev`). A serverless host has no process between requests, so it answers
# Telegram's webhook POSTs at /api/telegram/webhook instead — and then polling must
# stay off, or both delivery methods fight over the same updates.
# The token comes from @BotFather; without it the API still serves the app and the
# assistant just stays offline. Keep it out of version control.
TELEGRAM_BOT_TOKEN=paste_the_botfather_token
# Fallback @username shown in the app's Profile screen before the bot connects.
TELEGRAM_BOT_USERNAME=your_bot_username
# Set on a serverless deploy to the full https URL of /api/telegram/webhook. It both
# switches delivery to webhook and tells the app the assistant is reachable. On Vercel
# it can stay unset — the deployment's own host is used — but setting it is explicit.
# TELEGRAM_WEBHOOK_URL=https://your-app.vercel.app/api/telegram/webhook
# Telegram echoes this back in a header on every update, which is what proves an update
# is Telegram's and not someone forging a message from a linked chat. Falls back to
# BOT_API_KEY when unset.
# TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string
# Shared secret for the HTTP mirror at /api/bot/*, used only if you run the
# standalone github.com/Sultanast01/allawii-bot against this server instead. Also the
# key for /api/telegram/webhook/setup and /nudges.
BOT_API_KEY=generate_a_long_random_string
# On Vercel, set this to any long random string: the platform sends it to a cron path
# as `Authorization: Bearer <CRON_SECRET>`, which is what opens /api/telegram/nudges.
# CRON_SECRET=generate_a_long_random_string

# Password for the synthetic demo persona, auto-created in Supabase Auth on first use.
DEMO_PASSWORD=change-this-demo-password
